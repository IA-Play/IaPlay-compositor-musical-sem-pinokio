<?php
// ---------------------------------------------------------------
// IAPLAY — Variáveis de Ambiente
// Renomeie este arquivo para .env.php
// Em produção (Hostinger), configure via painel → PHP → Environment Variables
// ---------------------------------------------------------------

// Banco de Dados
putenv('DB_HOST=localhost');
putenv('DB_NAME=iplay_db');
putenv('DB_USER=iplay_user');
putenv('DB_PASS=sua_senha_segura_aqui');

// SMTP (E-mail) — OBRIGATÓRIO para envio de e-mails
putenv('SMTP_HOST=smtp.hostinger.com');
putenv('SMTP_PORT=465');
putenv('SMTP_USER=suporte@iaplay.app');
putenv('SMTP_PASS=sua_senha_smtp_aqui');
putenv('SMTP_FROM=suporte@iaplay.app');
putenv('SMTP_FROM_NAME=IAPLAY');

// Chave de Criptografia para APIs — OBRIGATÓRIO
// Gere uma chave aleatória: php -r "echo bin2hex(random_bytes(32));"
putenv('ENCRYPTION_KEY=sua_chave_de_criptografia_64_chars_hex');